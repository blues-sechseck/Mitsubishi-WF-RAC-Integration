  "issues": {
    "too_many_devices": {
      "title": "{device_name} 上注册的账户过多",
      "description": "此机组最多可注册四个账户，目前四个已全部占用，因此 Home Assistant 无法注册。模块不会自行释放名额：注册不会过期，新的注册会被拒绝，而不会替换旧的。请在 Smart M-Air 应用中，从不再需要该机组的手机上将其移除——每个账户只能移除自己，而共用同一个 Smart M-Air 账户的多部手机合计只占一个名额。然后重新加载此集成。如果没有人能释放名额（例如早已转手的手机仍占用一个），则需要重新配置模块。"
    }
  },
  "options": {
    "step": {
      "init": {
        "description": "以下是你可以为此空调更改的选项。",
        "data": {
          "availability_retry_limit": "重试次数上限（最少 3）",
          "firmware_update_check": "固件更新检查（在线）"
